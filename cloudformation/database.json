{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "DynamoDB table for check-in data",
  "Parameters": {
    "TableName": {
      "Type": "String",
      "Default": "CheckInTable"
    }
  },
  "Resources": {
    "CheckInTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": {"Ref": "TableName"},
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "userId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "timestamp",
            "AttributeType": "N"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "userId",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "timestamp",
            "KeyType": "RANGE"
          }
        ]
      }
    }
  }
}
